# npm and pnpm configuration for this repository.
#
# Dependency build approvals are deliberately NOT set here. pnpm 12 reads
# `allowBuilds` from `pnpm-workspace.yaml`, and an `allow-build` key in this file
# is unknown to npm, which prints
#   npm warn Unknown project config "allow-build"
# on every npm invocation inside the repository — noise for anyone who happens
# to run `npm install` or `npm view` here, and a warning that trains people to
# ignore warnings. The approval lives in exactly one place instead.

# The `engines` field is advisory rather than enforced: a contributor on an older
# Node gets a clear message from the tooling instead of an install that refuses
# to start.
engine-strict=false
